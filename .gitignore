# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
!static/js/editor/build/
venv/
.venv/
*.egg

# Environment
.env
.env.bak.*
!.env.example

# Data — all user data stays local
data/
!services/hwfit/data/
!services/hwfit/data/hf_models.json
logs/
*.log
*.db
*.sqlite
*.sqlite3

# Node
node_modules/
services/node_modules/
services/data/

# IDE / Editor
.aider*
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# Test capture artifacts (browser session dumps may contain personal content)
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.cache
cache/
output.txt.txt

# Media (uploaded/generated)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.tiff
*.pdf

# …except shipped demo assets in docs/ that the README links to.
!docs/*.jpg
!docs/*.jpeg
!docs/*.png
!docs/*.gif
!docs/*.webp
# …and curated docs/ subfolder assets (e.g. accessibility before/after shots).
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.gif
!docs/**/*.webp

# Reports and temp files
reports/
tasks/
scripts/compound/*.json
research_data/
**/search_analytics.json

# Internal dev/review notes — not for public repo
dev-docs/
# Windows-port working docs (local only, not for public repo)
docs/windows-port/

# Local config
compound.config.json
*.error.log
_scratch/

# iPhone tunnel — live public URL written by start-iphone-tunnel.ps1. ngrok
# logs already match *.log above.
.ofp-tunnel-url

# OFP route persistence — routes/ofp_local_api_routes.py writes every
# POST/PUT/DELETE to this file at the repo root. User-created jobs/customers
# etc. would leak into a commit if not ignored.
.ofp-store.json

# CI workflow templates + dev hooks — held back per "minimum: code + tests
# + docs only" scope. Future recursive staging has dragged GitHub issue/PR
# templates and pre-commit hook implementations into the push otherwise.
.github/
.husky/

# Pre-commit config — local tooling, not for github push.
.pre-commit-config.yaml

# OFP push-recipe holdbacks (mirror of the 10-item HOLD regex in
# docs/push-recipe.md). These paths are intentionally local — a committed
# copy would either leak a per-run test artifact (coverage.json), a scratch
# note (TODO.md), or a runtime cache (Agents/). If you need to commit any of
# these intentionally, do it explicitly (no `git add -A`), and document in
# the matching push-recipe bullet why it was promoted out of the holdback
# list.
coverage.json
TODO.md
Agents/
