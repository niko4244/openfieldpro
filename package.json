{
  "name": "openfieldpro",
  "private": true,
  "version": "0.1.0",
  "description": "OpenFieldPro — open-source, self-hostable field service operations",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @ofp/api dev",
    "dev:web": "pnpm --filter @ofp/web dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @ofp/db generate",
    "db:check": "pnpm --filter @ofp/db check",
    "db:parity": "pnpm --filter @ofp/db schema:parity",
    "db:migrate": "pnpm --filter @ofp/db migrate",
    "db:push": "pnpm --filter @ofp/db push",
    "db:seed": "pnpm --filter @ofp/db seed",
    "test": "pnpm -r test",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "test:release": "node --test scripts/audit-dependencies.test.mjs",
    "lock:prepare": "pnpm install --lockfile-only --no-frozen-lockfile --reporter=silent && node scripts/verify-lockfile.mjs",
    "install:verified": "pnpm lock:prepare && pnpm install --frozen-lockfile --reporter=silent",
    "release:safety": "node scripts/release-safety-check.mjs && node scripts/verify-lockfile.mjs && pnpm test:release",
    "infra:up": "podman compose -f infra/compose.yml up -d",
    "infra:down": "podman compose -f infra/compose.yml down"
  },
  "pnpm": {
    "overrides": {
      "fast-jwt": "6.2.4",
      "postcss": "8.5.17",
      "tar": "7.5.19",
      "@xmldom/xmldom": "0.8.13",
      "uuid": "11.1.1",
      "esbuild": "0.25.12"
    }
  },
  "engines": { "node": ">=22" }
}
