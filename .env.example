# --- OpenFieldPro environment ---
# Copy to .env and fill. Never commit .env.

# Postgres (matches infra/compose.yml)
DATABASE_URL=postgres://ofp:ofp@localhost:5433/ofp

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage for photos/attachments)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ofpminio
S3_SECRET_KEY=ofpminio-secret
S3_BUCKET=ofp-uploads

# API
API_PORT=3001
JWT_SECRET=change-me-in-production

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Payments (Stripe) — leave blank for offline/manual invoicing in Phase 1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sponsor slot (Free plan only; docs/SPONSOR_SLOT.md). Static, local, no
# tracking — leave blank for the default open-source house line.
NEXT_PUBLIC_SPONSOR_NAME=
NEXT_PUBLIC_SPONSOR_TEXT=
NEXT_PUBLIC_SPONSOR_URL=

# License verification (docs/LICENSES.md). Leave blank to use the project's
# baked-in public key. Forks issuing their own keys set an SPKI PEM here.
# The SIGNING (private) key never goes in env or the repo — it lives at
# ~/.ofp/license-signing-key.pem on the maintainer's machine only.
OFP_LICENSE_PUBLIC_KEY=
