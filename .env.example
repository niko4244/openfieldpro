# --- OpenFieldPro environment ---
# Copy to .env and fill. Never commit .env.

# Postgres (matches infra/compose.yml)
DATABASE_URL=postgres://ofp:ofp@localhost:5433/ofp

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage for photos/attachments)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ofpminio
S3_SECRET_KEY=ofpminio-secret
S3_BUCKET=ofp-uploads

# API
API_PORT=3001
JWT_SECRET=change-me-in-production

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Payments (Stripe) — leave blank for offline/manual invoicing in Phase 1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
