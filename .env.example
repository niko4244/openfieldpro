# --- OpenFieldPro environment ---
# Copy to .env for local development. Replace every production secret before using deploy.sh.

# Postgres (matches infra/compose.yml for local development)
DATABASE_URL=postgres://ofp:ofp@localhost:5432/ofp
POSTGRES_PASSWORD=ofp

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage for photos/attachments)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ofpminio
S3_SECRET_KEY=ofpminio-secret
S3_BUCKET=ofp-uploads

# API
API_PORT=3001
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Web. Use the origin only; app code appends /api paths.
NEXT_PUBLIC_API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:8080

# Payments (Stripe) — leave blank for offline/manual invoicing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
