{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/niko4244/openfieldpro/blob/ofp-monorepo/docs/operations/official-release-manifest.schema.json",
  "title": "OpenFieldPro official release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "channel", "sourceRepository", "sourceCommit", "publishedAt", "artifacts"],
  "properties": {
    "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["stable", "candidate"] },
    "sourceRepository": { "const": "niko4244/openfieldpro" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "sponsor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "text": { "type": "string", "maxLength": 180 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}

