{
  "name": "@ofp/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --experimental-test-module-mocks --test test/*.test.ts",
    "license:keypair": "tsx scripts/make-license-key.ts --generate-keypair",
    "license:generate": "tsx scripts/make-license-key.ts",
    "license:verify": "tsx scripts/verify-license-key.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^9.4.0",
    "@ofp/db": "workspace:*",
    "@ofp/plugin-sdk": "workspace:*",
    "@ofp/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "file-type": "^22.0.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
